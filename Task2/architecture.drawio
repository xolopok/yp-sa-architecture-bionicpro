        </mxCell>
        <mxCell id="task2-rel-cdn-s3-lbl" connectable="0" parent="task2-rel-cdn-s3" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#1B9436;labelBackgroundColor=default;" value="Обращение к бакету-источнику&lt;br&gt;[S3 API]" vertex="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="task2-rel-reports-olap" edge="1" parent="1" source="task2-cnt-reports-svc" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1B9436;strokeWidth=2;" target="task2-cnt-olap">
