          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="task2-rel-cdn-s3" edge="1" parent="1" source="task2-cnt-cdn" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1B9436;strokeWidth=2;" target="task2-cnt-s3">
