          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="task2-rel-airflow-crmdb" edge="1" parent="1" source="task2-cnt-airflow" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1B9436;strokeWidth=2;" target="-s9W17W-NFw-Ta7AQgpa-17">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="task2-rel-airflow-crmdb-lbl" connectable="0" parent="task2-rel-airflow-crmdb" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#1B9436;labelBackgroundColor=default;" value="Выгрузка клиентов&lt;br&gt;и протезов [JDBC / TCP]" vertex="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="task2-rel-airflow-db" edge="1" parent="1" source="task2-cnt-airflow" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1B9436;strokeWidth=2;" target="Lhtp9tOnbV0N8Cz71-gY-12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="task2-rel-airflow-db-lbl" connectable="0" parent="task2-rel-airflow-db" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#1B9436;labelBackgroundColor=default;" value="Пакетная выгрузка&lt;br&gt;телеметрии датчиков&lt;br&gt;[PostgreSQL / TCP]" vertex="1">
          <mxGeometry relative="1" y="40" as="geometry">
            <mxPoint x="-40" y="1" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="task2-rel-airflow-olap" edge="1" parent="1" source="task2-cnt-airflow" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1B9436;strokeWidth=2;" target="task2-cnt-olap">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="task2-rel-airflow-olap-lbl" connectable="0" parent="task2-rel-airflow-olap" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#1B9436;labelBackgroundColor=default;" value="Загрузка слоёв, расчёт витрины&lt;br&gt;prosthesis_reports_mart и дат ETL&lt;br&gt;[HTTP / Native]" vertex="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="task2-note-etl" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#e3c800;strokeColor=#B09500;align=left;verticalAlign=top;spacing=16;fontSize=11;fontColor=#000000;" value="&lt;h3&gt;ETL и витрина отчётности&lt;/h3&gt;&lt;div&gt;&lt;b&gt;Оркестрация (Apache Airflow):&lt;/b&gt; ежедневный DAG bionicpro_reports_etl извлекает по расписанию данные клиентов и протезов из CRM DB и телеметрию миодатчиков из транзакционной Базы данных.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Витрина (ClickHouse):&lt;/b&gt; пайплайн объединяет источники и записывает суточные агрегаты в витрину prosthesis_reports_mart с ключом сортировки (username, report_date, prosthesis_id).&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Разгрузка OLTP:&lt;/b&gt; сервис отчётов читает готовые агрегаты из OLAP БД по первичному индексу пользователя и не нагружает транзакционную базу PostgreSQL.&lt;/div&gt;" vertex="1">
          <mxGeometry height="225" width="520" x="-460" y="130" as="geometry" />
        </mxCell>
        <mxCell id="task2-note-security" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#e3c800;strokeColor=#B09500;align=left;verticalAlign=top;spacing=16;fontSize=11;fontColor=#000000;" value="&lt;h3&gt;Контроль периода и изоляция доступа&lt;/h3&gt;&lt;div&gt;&lt;b&gt;Аутентификация и RBAC:&lt;/b&gt; сервис отчётов проверяет подпись Bearer JWT по JWKS Keycloak и требует роль prothetic_user (401 без валидного токена, 403 без роли).&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Доступ только к своим данным:&lt;/b&gt; владелец отчёта определяется строго по клейму preferred_username из проверенного JWT. Запрос отчёта другого пользователя отклоняется с кодом 403.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Контроль периода ETL:&lt;/b&gt; сервис сверяет запрошенные даты с таблицей etl_processed_dates и возвращает 409 Conflict, если Airflow ещё не завершил расчёт за период.&lt;/div&gt;" vertex="1">
          <mxGeometry height="225" width="520" x="-460" y="375" as="geometry" />
        </mxCell>
        <mxCell id="task2-note-cache" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#e3c800;strokeColor=#B09500;align=left;verticalAlign=top;spacing=16;fontSize=11;fontColor=#000000;" value="&lt;h3&gt;Кэширование отчётов (S3 + CDN)&lt;/h3&gt;&lt;div&gt;&lt;b&gt;Неизменяемость данных:&lt;/b&gt; суточные агрегаты за завершённые дни не меняются после расчёта в Airflow, поэтому готовые файлы отчётов (CSV, JSON) кэшируются без риска устаревания.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Объектный кэш S3:&lt;/b&gt; при промахе кэша сервис формирует отчёт из витрины ClickHouse и сохраняет его в объектном хранилище S3.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Раздача через CDN:&lt;/b&gt; повторные скачивания обслуживает CDN перед S3 с edge-узлов, разгружая сервис отчётов и OLAP БД без изменения контракта API.&lt;/div&gt;" vertex="1">
          <mxGeometry height="225" width="520" x="-460" y="620" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
